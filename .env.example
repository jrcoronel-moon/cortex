# Cortex — environment configuration
# Copy to `.env` (Docker Compose) or `.env.local` (local dev) and fill in.
# Everything except SESSION_SECRET is optional; the app degrades gracefully.

# ── Session signing (REQUIRED in production) ───────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── Database ───────────────────────────────────────────────────────────────
# Defaults to ./cortex.db next to the app. Docker Compose sets /app/data/cortex.db.
# DB_PATH=""

# ── Administrators ─────────────────────────────────────────────────────────
# Comma-separated emails granted the platform admin role (access to /admin).
ADMIN_EMAILS=""
# Optional: grant admin to every address on this domain, e.g. "yourcompany.com".
ADMIN_DOMAIN=""

# ── Email (magic-link sign-in) ─────────────────────────────────────────────
# Without SMTP the server falls back to an Ethereal test inbox and prints the
# sign-in link to the server log — fine for local development.
SMTP_HOST=""
SMTP_PORT="587"          # 465 for SSL/TLS, 587 for STARTTLS
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Cortex" <no-reply@example.com>'

# ── Google sign-in (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── BYOK encryption (required for the AI assistant) ────────────────────────
# Encrypts each user's own provider API key at rest with AES-256-GCM.
# Must be 64 hex characters (32 bytes): openssl rand -hex 32
# Keep it stable — changing it makes previously saved keys undecryptable.
BYOK_ENCRYPTION_KEY=""

# ── Public base URL ────────────────────────────────────────────────────────
# Used to build absolute links (MCP OAuth metadata, invitation emails).
APP_BASE_URL="http://localhost:3000"

# ── Litestream: continuous SQLite backup to S3 (optional) ──────────────────
LITESTREAM_BUCKET=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
